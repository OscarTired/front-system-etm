+    { label: "Creado", value: formatDateTime(createdAt) },
+    { label: "Última modificación", value: formatDateTime(updatedAt) },
+    ...(updatedBy
+      ? [{ label: "Modificado por", value: updatedBy.name }]
+      : []),
+  ]
+
+  return (
+    <Popover>
