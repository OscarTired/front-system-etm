-
-  const progressPercent =
-    totalTasks === 0
-      ? 0
-      : Math.round(
-          (completed.length / totalTasks) * 100,
-        )
-
-  return {
-    totalTasks,
-    totalPieces,
-    inProgressCount: inProgress.length,
-    completedCount: completed.length,
-    urgentCount: urgent.length,
