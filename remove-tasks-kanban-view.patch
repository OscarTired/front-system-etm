-  const totalPieces = tasks.reduce(
-    (sum, task) =>
-      sum + task.pieces,
-    0,
-  )
-
-  const completed = tasks.filter(
-    task =>
-      isWorkflowCompleted(
-        task.workflowSteps,
-      ),
-  )
-
-  const inProgress = tasks.filter(
