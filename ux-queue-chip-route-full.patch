+/** Chip de proceso previo: mismo tamaño que "Iniciar", click = ruta a la tarea. */
+function QueueProcessChip({
+  code,
+  label,
+  color,
+  Icon,
+  onClick,
+}: {
+  code: string
+  label: string
+  color: string
+  Icon?: ComponentType<{ size?: number; className?: string }>
