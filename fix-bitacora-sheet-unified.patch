+    e.preventDefault()
+    e.stopPropagation()
+  }
+  shield.addEventListener("pointerdown", block, true)
+  shield.addEventListener("pointerup", block, true)
+  shield.addEventListener("click", block, true)
+  document.body.appendChild(shield)
+  window.setTimeout(() => shield.remove(), ms)
+}
