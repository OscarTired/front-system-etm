-    textFaint: "var(--on-glass-faint)",
+    background: `linear-gradient(135deg, ${rgbString(start)}, ${rgbString(end)})`,
+    backgroundInset: `linear-gradient(135deg, ${rgbString(start)}, ${rgbString(end)})`,
+    text,
+    textMuted,
+    textFaint: withAlpha(text, 0.45),
   }
 }
